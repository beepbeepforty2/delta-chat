# Copy to .env and adjust. All values shown are the defaults baked into
# the code (src/canonical/classify.py, src/delta/align.py,
# src/delta/classify.py, src/ingest/pdf_native.py) -- this file documents
# them, it isn't required for the defaults to take effect.

# --- src/delta/align.py: bipartite match cost weights ----------------------
DELTA_W_TEXT=0.6
DELTA_W_SPATIAL=0.4
DELTA_MAX_MATCH_COST=0.55

# --- src/delta/classify.py ---------------------------------------------
DELTA_MOVE_THRESHOLD=0.03
DELTA_CASCADE_MIN_FAMILY_SIZE=3

# --- src/ingest/pdf_native.py -------------------------------------------
PDF_NATIVE_MIN_TEXT_WORDS=20
PDF_NATIVE_GAP_MULTIPLIER=3.0
PDF_NATIVE_Y_TOL_RATIO=0.5
PDF_NATIVE_RASTER_DPI=150
PDF_NATIVE_RASTER_CACHE_DIR=raster_cache

# --- src/canonical/classify.py: Tier-2 region fallback ----------------------
# semicolon-separated rects, each "x0,y0,x1,y1" (normalized, top-left/y-down)
# TITLE_BLOCK_RECTS=0.70,0.85,1.0,1.0
# DATASHEET_RECTS=0.55,0.55,1.0,0.80;0.0,0.68,0.25,0.88
ZONE_LABEL_MARGIN=0.02
BORDER_MARGIN_TOL=0.03

# --- src/chat/retrieval.py: domain alias table for BM25 query expansion --
# DOMAIN_ALIASES_PATH=config/domain.yaml

# --- src/delta/semantic_null.py -------------------------------------------
# Opt-in: the one place a live LLM call can sit in the otherwise fully
# deterministic delta path (CLAUDE.md decision #3's "isolated,
# documented non-deterministic zone"). Off by default.
# DELTA_SEMANTIC_NULL_LLM=1

# --- src/chat/llm.py -----------------------------------------------------
# auth_token is preferred over api_key when both are set (matches providers
# whose Anthropic-compatible proxy expects a bearer token, e.g. GLM/z.ai,
# rather than the x-api-key header api_key sends).
# LLM_API_KEY=
# LLM_AUTH_TOKEN=
# LLM_BASE_URL=              # unset = real Anthropic API
# LLM_MODEL=claude-sonnet-5  # or a compatible provider's model string

# --- eval/chat_eval.py: LLM-judge backend (structurally separate from the
# chat backend above -- see src/chat/llm.py::get_judge_client) ------------
# Falls back to the LLM_* values above when unset, meaning the judge
# reuses the same backend it's judging until a second credential is
# configured here -- src/chat/llm.py::judge_is_same_backend() reports
# this honestly in the eval scorecard rather than presenting the judge as
# independent when it isn't.
# JUDGE_LLM_API_KEY=
# JUDGE_LLM_AUTH_TOKEN=
# JUDGE_LLM_BASE_URL=
# JUDGE_MODEL=
# JUDGE_MAX_TOKENS=200

# --- eval/baselines/backend_compare.py: optional 2nd/3rd backend for the
# cost/latency/determinism comparison table (needs >=2 configured to run;
# prints "N/1 backends configured" and exits cleanly otherwise) ------------
# BACKEND_2_NAME=
# BACKEND_2_BASE_URL=
# BACKEND_2_AUTH_TOKEN=
# BACKEND_2_API_KEY=
# BACKEND_2_MODEL=
# BACKEND_3_NAME=
# BACKEND_3_BASE_URL=
# BACKEND_3_AUTH_TOKEN=
# BACKEND_3_API_KEY=
# BACKEND_3_MODEL=
