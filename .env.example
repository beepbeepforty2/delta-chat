# Copy to .env and adjust. All values shown are the defaults baked into
# the code (src/canonical/classify.py, src/delta/align.py,
# src/delta/classify.py, src/ingest/pdf_native.py) -- this file documents
# them, it isn't required for the defaults to take effect.

# --- src/delta/align.py: bipartite match cost weights ----------------------
DELTA_W_TEXT=0.6
DELTA_W_SPATIAL=0.4
DELTA_MAX_MATCH_COST=0.55
DELTA_NEAR_MISS_SATURATION_MARGIN=0.4  # how far a rejected near-miss cost
                                        # must exceed MAX_MATCH_COST before
                                        # an add/remove's confidence guard
                                        # returns to 1.0 (fully unambiguous)

# --- src/delta/classify.py ---------------------------------------------
DELTA_MOVE_THRESHOLD=0.03
DELTA_CASCADE_MIN_FAMILY_SIZE=3

# --- src/delta/precheck.py -----------------------------------------------
# tag-content-overlap fallback tier, used only when neither drawing number
# nor equipment tag is extractable on either document
PRECHECK_TAG_OVERLAP_MIN=0.3

# --- src/ingest/pdf_native.py -------------------------------------------
PDF_NATIVE_MIN_TEXT_WORDS=20
PDF_NATIVE_GAP_MULTIPLIER=3.0
PDF_NATIVE_Y_TOL_RATIO=0.5
PDF_NATIVE_RASTER_DPI=150
PDF_NATIVE_RASTER_CACHE_DIR=raster_cache
PDF_NATIVE_INSTRUMENT_BUBBLE_PADDING_RATIO=0.6  # padding around a circle's
                                   # own bbox (as a fraction of its size)
                                   # when looking for stacked instrument-
                                   # bubble text (func/loop/system on
                                   # separate baselines) inside it -- 0.6
                                   # because the system/unit label sits
                                   # OUTSIDE the bubble on real samples

# --- src/canonical/classify.py: Tier-2 region fallback ----------------------
# semicolon-separated rects, each "x0,y0,x1,y1" (normalized, top-left/y-down)
# TITLE_BLOCK_RECTS=0.70,0.85,1.0,1.0
# DATASHEET_RECTS=0.55,0.55,1.0,0.80;0.0,0.68,0.25,0.88
ZONE_LABEL_MARGIN=0.02
BORDER_MARGIN_TOL=0.03

# --- src/chat/retrieval.py: domain alias table for BM25 query expansion --
# DOMAIN_ALIASES_PATH=config/domain.yaml

# --- src/delta/semantic_null.py -------------------------------------------
# Opt-in: the one place a live LLM call can sit in the otherwise fully
# deterministic delta path (DESIGN.md decision #3's "isolated,
# documented non-deterministic zone"). Off by default.
# DELTA_SEMANTIC_NULL_LLM=1

# --- src/delta/raster_diff.py + src/delta/raster_join.py: raster recall net
# Opt-in registered raster-diff layer -- "raster localizes, symbolic
# classifies": proposes candidate change regions with pure CV (SSIM
# structural diff, morphological cleanup, connected components), then
# subtracts out anything the symbolic pipeline already explained,
# emitting only the unexplained residue as unclassified_visual_change
# deltas. Off by default -- deterministic when on (no LLM anywhere in
# this stage). See docs/findings.md for the measured null-pair region
# count and recall-lift/residue-precision numbers.
# DELTA_RASTER_DIFF=1
RASTER_DIFF_DPI=150               # informational only -- reuses the already-
                                   # rasterized L0 PNGs, never re-renders
RASTER_DIFF_THRESHOLD=0.25        # on the [0,1] SSIM-derived diff-magnitude map
RASTER_DIFF_OTSU_BINARIZE=0
RASTER_DIFF_USE_SSIM=1            # 0 forces the Gaussian-blur+absdiff fallback
RASTER_DIFF_SSIM_WIN_SIZE=7
RASTER_DIFF_BLUR_SIGMA=1.0        # fallback path only
RASTER_DIFF_ENABLE_OPEN=1         # morphological open: kills 1px AA fringe
RASTER_DIFF_OPEN_KERNEL=3
RASTER_DIFF_ENABLE_MERGE=1        # dilate: merges a cluster of strokes into one region
RASTER_DIFF_MERGE_KERNEL=9
RASTER_DIFF_MIN_AREA_PX=150       # drops single-pixel/speck regions
RASTER_DIFF_MAX_AREA_FRAC=0.25    # drops whole-page-shift-sized "regions"
                                   # (a registration failure, not a change)
RASTER_JOIN_EXPLAIN_IOU=0.10      # region/symbolic-delta-bbox overlap that
                                   # counts as "already explained" -> skipped
RASTER_JOIN_TAG_PROXIMITY_NORM=0.02  # padding around a region when looking
                                   # for nearby tag text (a valve's drawn
                                   # glyph sits adjacent to, not overlapping,
                                   # its own tag's extracted bbox)
RASTER_JOIN_CONF_BASE=0.15
RASTER_JOIN_CONF_SCALE=0.35
RASTER_JOIN_CONF_CAP=0.45         # emitted confidence is always < this --
                                   # never presented as a confident classification
RASTER_JOIN_ENABLE_TEXT_CONFIRM=1 # suppress a region the symbolic layer
                                   # independently confirms is UNCHANGED text
                                   # (e.g. a font/producer change) -- the
                                   # ensemble half of "raster localizes,
                                   # symbolic classifies": a confirmed-
                                   # unchanged reading suppresses, the same
                                   # way a confirmed CHANGE already does
RASTER_JOIN_TEXT_CONFIRM_OVERLAP_FRAC=0.6  # how much of the region must be
                                   # directly covered (not just nearby, like
                                   # TAG_PROXIMITY_NORM above) by that
                                   # unchanged text to suppress

# --- src/chat/llm.py -----------------------------------------------------
# auth_token is preferred over api_key when both are set (matches providers
# whose Anthropic-compatible proxy expects a bearer token, e.g. GLM/z.ai,
# rather than the x-api-key header api_key sends).
# LLM_API_KEY=
# LLM_AUTH_TOKEN=
# LLM_BASE_URL=              # unset = real Anthropic API
# LLM_MODEL=claude-sonnet-5  # or a compatible provider's model string

# --- eval/chat_eval.py: LLM-judge backend (structurally separate from the
# chat backend above -- see src/chat/llm.py::get_judge_client) ------------
# Falls back to the LLM_* values above when unset, meaning the judge
# reuses the same backend it's judging until a second credential is
# configured here -- src/chat/llm.py::judge_is_same_backend() reports
# this honestly in the eval scorecard rather than presenting the judge as
# independent when it isn't.
# JUDGE_LLM_API_KEY=
# JUDGE_LLM_AUTH_TOKEN=
# JUDGE_LLM_BASE_URL=
# JUDGE_MODEL=
# JUDGE_MAX_TOKENS=200

# --- eval/baselines/backend_compare.py: optional 2nd/3rd backend for the
# cost/latency/determinism comparison table (needs >=2 configured to run;
# prints "N/1 backends configured" and exits cleanly otherwise) ------------
# BACKEND_2_NAME=
# BACKEND_2_BASE_URL=
# BACKEND_2_AUTH_TOKEN=
# BACKEND_2_API_KEY=
# BACKEND_2_MODEL=
# BACKEND_3_NAME=
# BACKEND_3_BASE_URL=
# BACKEND_3_AUTH_TOKEN=
# BACKEND_3_API_KEY=
# BACKEND_3_MODEL=
