# secrets -- never commit
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Base PDFs for the held-out set are NOT redistributable: the source page
# carries a third-party course copyright. Only the CROPPED derivative is
# committed (eval/datasets/holdout/), containing solely the EPA public-domain
# figure -- see that pair's gt/provenance.json for the full chain.
# eval/datasets/holdout/ is deliberately NOT ignored: a holdout has to be
# committed to serve as a fixed reference.
tools/holdout/*.pdf
.zcode/

# generated / regenerable (see Makefile: make dataset, make run, make eval)
eval/datasets/v0/
eval/results/
raster_cache/
reports/
traces/
# per-job uploads + artifacts from `make web`; the job store is in-process,
# so anything left here is from a previous run and is safe to delete.
.web_jobs/

# os cruft
.DS_Store

# optional browser-test harness (tools/uicheck.mjs) -- see its header
tools/uicheck-shots/
node_modules/
package-lock.json
package.json
