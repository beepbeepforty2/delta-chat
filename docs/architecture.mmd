flowchart TD
    subgraph Ingest["src/ingest/ — FormatAdapter seam"]
        FA[PID A file]
        FB[PID B file]
        DET{"adapter.detect()"}
        FA --> DET
        FB --> DET
        DET -->|text-rich| PN["PdfNativeAdapter\n(fitz extraction)"]
        DET -->|text-sparse| PS["PdfScannedAdapter\n(pytesseract OCR)"]
        DET -->|.dwg| DWG["DWGAdapter\n(real stub — not implemented)"]
    end

    subgraph Canonical["src/canonical/ — layered IR"]
        PN --> CD["CanonicalDocument"]
        PS --> CD
        CD --> L0["L0 raster\n(retained PNG per sheet)"]
        CD --> L1["L1 elements\n(typed, zoned, bbox, extraction_confidence)"]
        CD -.->|declared, never populated| L2["L2 relations"]
        CD -.->|not implemented| L3["L3 embeddings"]
        L1 --- ZN["zones.py\nborder-grid A–J × 1–12"]
        L1 --- TG["tags.py\ncomposite tag parsing"]
        L1 --- CL["classify.py\nelement-type classification"]
    end

    subgraph DeltaEngine["src/delta/ — deterministic pipeline"]
        CD --> PC{"precheck.py\nsame document?"}
        PC -->|"no"| REFUSE(["refuse: not_a_pair"])
        PC -->|"yes"| REG["register.py\nUmeyama similarity transform\nfrom anchor correspondences"]
        REG --> MS["align.py\nmatch_sheets"]
        MS --> ME["align.py\nmatch_elements\n(Hungarian bipartite match)"]
        ME --> CLS["classify.py\nadd / remove / modify / move\n+ cascade grouping"]
        CLS --> SEV["severity.py\nCRITICAL / HIGH / MEDIUM / LOW"]
        SEV --> SN["semantic_null.py\nrule (DELETED-collapse, always on) +\nopt-in LLM adjudication (reword-equivalence)"]
        SN --> RR["raster_recall.py (opt-in)\nconfidence-gated registered pixel diff\n→ unclassified_visual_change, low confidence"]
    end

    subgraph Output["Report + Markup"]
        RR --> RPT["report.py\ndelta_report.json / .md\nseverity-sorted"]
        RR --> MKP["markup/pdf_annotate.py (default)\nreal PDF Square annotations\non the original PDFs"]
        RR --> MKPNG["markup/overlay.py (--format png)\nraster PNG preview, legended"]
        CD --> MKP
        CD --> MKPNG
    end

    subgraph Chat["src/chat/ — grounded Q&A"]
        CD --> CHK["retrieval.py\nbuild_chunks(A, B, deltas)"]
        RR --> CHK
        DOM["config/domain.yaml\nquery-alias expansion\n(trip→sd/hh/ll, spec→pipe_class, …)"] -.additive.-> BM25
        CHK --> BM25["BM25Index\n(homegrown Okapi,\ndelta-source boost 1.5×, zone-aware)"]
        BM25 --> ANS["chat.py: answer()"]
        ANS --> LLMC["llm.py: get_client()/MODEL\nGLM via Anthropic-compatible API\n(base_url + auth_token)"]
        LLMC --> CIT["citations.py\npost-validate ids;\nforced refusal if unsupported"]
        CIT --> OUT["ChatAnswer\n(text, citations, refused, reason)"]
    end

    subgraph Obs["src/observability/ — homegrown tracer"]
        TR["Tracer\nspans · correlation id · JSONL logs ·\nper-request trace file · LLM span telemetry"]
    end
    Ingest -.instruments.-> TR
    DeltaEngine -.instruments.-> TR
    Chat -.instruments.-> TR

    subgraph Eval["eval/ — harness"]
        GEN["eval/datasets/generator\nseeded pairs + 3-layer GT"] --> RE["run_eval.py"]
        RPT --> RE
        OUT --> RE
        CAL["calibration.py\nconfidence-band precision check"] --> RE
        BASE["baselines/llm_direct.py\n3× @ temp=0, same score_pair path"] --> RE
        RE --> SC["scorecard:\ndelta P/R/F1 (overall/kind/level/primary-cascade) ·\nconfidence calibration · semantic-null detection P/R ·\nnull-pair FP · not_a_pair refusal ·\nchat correctness (LLM-judge)/groundedness/refusal ·\nllm_direct variance"]
    end

    subgraph Tools["tools/ + eval/baselines/ — dev utilities, outside the request/response pipeline"]
        CMP["compare_models.py\nsame pair, same credential,\ndifferent model names, usage side by side"]
        BC["backend_compare.py\nmulti-backend cost/latency\n(scaffolded — needs a 2nd credential)"]
        VD["visual_diff.py\nnaive independent matcher,\nhuman-in-the-loop debug viewer"]
    end
